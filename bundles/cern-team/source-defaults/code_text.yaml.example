# OPTIONAL — The text of the code in the GitHub repository that
# github_repo.yaml.example clones: function and class bodies as searchable,
# readable chunks. code_structure.yaml.example gives each function's name,
# signature, docstring and line numbers, but not its body, so a question like
# "what does this function do when the name contains a slash" cannot be
# answered from the graph without this source.
#
# Rename to code_text.yaml to enable, together with github_repo.yaml (rename
# github_repo.yaml.example and answer `github_repo_url` at install time). This
# source reads that source's checkout and clones nothing itself.
# code_structure.yaml is not required, but the two are meant to run together:
# symbols for finding a function, text for reading it.
#
# What lands in the graph, per file:
#   - a `document` node `doc:<repo>:<path>`, linked `derived_from` the
#     `file:<repo>:<path>` node that github_repo emits. Reading the text of
#     the file node points you to this document.
#   - `document_chunk` nodes holding the code. Python is cut by okg's
#     PythonSymbolChunker: one chunk per top-level function, per class (or per
#     method of a large class) and per run of module-level code, each carrying
#     `start_line`, `end_line` and `symbol`. The range starts at the blank or
#     comment lines above the definition, so it can begin a line or two
#     before the `def`; the first line holding code is the definition line.
#     Other languages are cut into
#     plain text windows. The parsers and chunk sizes are in the
#     extractors.yaml this bundle installs in the deployment directory.
#
# Size, measured on a 99-file repository with 77 Python files (686 KB of
# source, 528 functions): 77 documents, 613 chunk records holding 1.03x the
# source text (the largest chunk is 4,000 characters; 25 long functions are
# split into overlapping windows), 1,313 links, and 14.5 MB more database
# (134.5 MB against 120.0 MB for the same install without this source).
#
# This is NOT a secret scanner. File contents become searchable, so a
# credential committed to the repository becomes findable. The excludes below
# skip the usual credential file names; narrow `include_globs` further for a
# repository you have not reviewed.
#
# `repo` and `repo_root` are the SAME values github_repo uses. `extractors_dir`
# comes from the `code_extractors_dir` answer. Its default is okg's run-time
# placeholder for the deployment directory (see that question in profile.yaml),
# which okg expands each time it reads the source registry; that directory is
# where the profile installed extractors.yaml. (The installer expands every
# placeholder in this file, comments included, so the placeholder itself
# cannot be written here.)
#
# For a GitLab repository use code_text_gitlab.yaml.example.

code_text:
  module: okg.substrate.library.sources.doc_corpus
  class: DocCorpusSource
  ownership_id: ${deployment_name}.code-text
  admission_policy:
    producer_id: ${deployment_name}.code-text
    producer_kind: source
    trust_label: implicit_legacy_trusted
    admission_mode: fast_track
    authority_scope:
      source_family: cern-team
      source_name: code_text
    output_signature:
      nodes:
        - {subtype: document}
        - {subtype: document_chunk}
      edges:
        - {src_subtype: document, edge_type: derived_from, dst_subtype: source_file}
        - {src_subtype: document, edge_type: contains, dst_subtype: document_chunk}
        - {src_subtype: document_chunk, edge_type: member_of, dst_subtype: document}
    output_scope_summary:
      summary: the text of the code files in the configured GitHub repository, cut into function-sized chunks
      nodes: [document, document_chunk]
      edges:
        - document derived_from source_file
        - document contains document_chunk
        - document_chunk member_of document
  source_class: discovery_crawl
  record_identity_kind: scoped_locator
  record_identity_fields: [repo, path]
  source_revision_kind: content_hash
  deletion_semantics: missing_from_completed_scope
  publication_mode: published_generation
  required_for_baseline: false
  params:
    repo: '${github_repo_name}'
    # SINGLE-quoted, as in github_repo.yaml.example (answers are substituted
    # as text, then parsed as YAML).
    repo_root: '${archi_data_root}/repos/${github_repo_name}'
    extractors_dir: '${code_extractors_dir}'
    # Same extensions as code_structure.yaml.example.
    include_globs:
      - "**/*.py"
      - "**/*.js"
      - "**/*.jsx"
      - "**/*.ts"
      - "**/*.tsx"
      - "**/*.go"
      - "**/*.rs"
      - "**/*.c"
      - "**/*.cc"
      - "**/*.cpp"
      - "**/*.cxx"
      - "**/*.h"
      - "**/*.hpp"
    # okg routes only `.py` to a code parser by default. Without these routes
    # a matched file in any other language becomes a document with no text.
    extension_to_format:
      ".js": text
      ".jsx": text
      ".ts": text
      ".tsx": text
      ".go": text
      ".rs": text
      ".c": text
      ".cc": text
      ".cpp": text
      ".cxx": text
      ".h": text
      ".hpp": text
    exclude_globs:
      # Paths whose contents are credentials.
      - "**/.env"
      - "**/.env.*"
      - "**/secrets/**"
      - "**/secret/**"
      - "**/credentials/**"
      - "**/*credentials*"
      - "**/*.secret"
      # What github_repo skips.
      - "**/__pycache__/**"
      - "**/.venv/**"
      - "**/node_modules/**"
      - "**/.git/**"
      - "**/*.pyc"
    # Same caps as code_structure.yaml.example. A larger file is recorded as
    # an `oversize` document with no text, counted, and the run continues.
    max_files: 5000
    max_bytes_per_file: 1000000
    # A Python 2 file that does not parse is stored as plain text windows
    # (warning `text_fallback:code`) instead of a document with no text.
    text_fallback: true
    # Run after github_repo in the same cycle, so the file nodes exist and
    # each document gets its `derived_from` link on the first run.
    predecessor_source: '${deployment_name}.github-repo'
  sync:
    triggers: [manual, reconcile]
    default_event_mode: scope_complete
    reconcile_mode: scope_complete
