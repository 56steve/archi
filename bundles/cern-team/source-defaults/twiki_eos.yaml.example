# TWiki connector — the ONLY way TWiki reaches the cern-team bundle:
# an EOS dump read from disk. There is no live crawl and no anonymous
# web fallback. Adapted from the registry template in
# archi/sources/twiki.py (parser + emission proven against the cms
# parity corpus). Reads raw topic .txt files (with %META lines) from
# the directory you answer for `twiki_eos_root` (default
# data/twiki-snapshot) and emits topic pages, their text chunks, and
# topic-to-topic reference edges (topic_parent / wiki_link /
# bare_wikiword). Layout note: web_root names the web of the DUMP
# ROOT — topics of that web sit directly in the root (subdirectories
# are subwebs). A root that itself contains a <web_root>/ subdir
# double-prefixes every page id (twiki:CMS:CMS:...).
#
# To enable: rename this file to twiki_eos.yaml. eos_root comes from the
# `twiki_eos_root` install answer (no TWIKI_EOS_ROOT env indirection),
# so no credential_refs entry. `required: true`: a missing dump fails
# preflight loudly instead of silently shrinking scope.
twiki_eos:
  module: archi.sources.twiki
  class: TwikiEOSAdapter
  ownership_id: ${deployment_name}.twiki-eos
  admission_policy:
    producer_id: ${deployment_name}.twiki-eos
    producer_kind: source
    trust_label: implicit_legacy_trusted
    admission_mode: fast_track
    authority_scope:
      source_family: cern-team
      source_name: twiki_eos
    output_signature:
      nodes:
        - {subtype: documentation_page}
        - {subtype: document_chunk}
      edges:
        - {src_subtype: documentation_page, edge_type: references, dst_subtype: documentation_page}
        - {src_subtype: documentation_page, edge_type: contains, dst_subtype: document_chunk}
    output_scope_summary:
      summary: TWiki topics from a local EOS snapshot, their text chunks, and topic-to-topic references
      nodes: [documentation_page, document_chunk]
      edges:
        - documentation_page references documentation_page
        - documentation_page contains document_chunk
  source_class: discovery_crawl
  record_identity_kind: scoped_locator
  record_identity_fields: [path]
  source_revision_kind: content_hash
  deletion_semantics: missing_from_completed_scope
  publication_mode: published_generation
  required_for_baseline: false
  params:
    eos_root: '${twiki_eos_root}'
    web_root: CMS
    required: true
    # Optional seeded subtree instead of the whole snapshot:
    # seed_topics: [CMS/CompOpsHome]
    # max_depth: 2
    # Optional physics scoping (off here, and off by default): narrows a
    # CMS snapshot to physics topics -- PAG/POG/workbook roots, their
    # parent-topic closure, and documentation page types -- and drops the
    # computing-operations roots this bundle is otherwise built around.
    # physics_filter: true
    # Optional: also write the URL of a labelled web link
    # ([[URL][label]] -> "label (URL)") so an identifier that sits only
    # in the URL, such as a JIRA key in a /browse/ link, reaches the
    # text and gets linked. Off by default (the label alone).
    # link_urls: keep
  sync:
    triggers: [manual, reconcile]
    default_event_mode: scope_complete
    reconcile_mode: scope_complete
