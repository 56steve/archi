{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archi-physics/archi/blob/archi_v3/python/archi/bundles/schema/bundle.schema.json",
  "title": "Archi bundle manifest (bundle.yaml)",
  "description": "A named, versioned selection of packs plus a chat preset and an eval set (ADR 0002 section 3.2). Paths are relative to the directory holding bundle.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "packs", "okg"],
  "properties": {
    "name": {
      "description": "Bundle name. Must equal the directory name.",
      "$ref": "#/$defs/name"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "description": {"type": "string", "minLength": 1},
    "extends": {
      "description": "Bundles whose default packs this one inherits, resolved transitively.",
      "type": "array",
      "items": {"$ref": "#/$defs/name"},
      "uniqueItems": true
    },
    "packs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "description": "Packs installed unless removed with --without.",
          "type": "array",
          "items": {"$ref": "#/$defs/name"},
          "uniqueItems": true
        },
        "optional": {
          "description": "Packs offered for --with. Not installed unless asked for.",
          "type": "array",
          "items": {"$ref": "#/$defs/name"},
          "uniqueItems": true
        }
      }
    },
    "chat": {
      "description": "Chat preset. Scalars come from the last --bundle given; suggestions are a union.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site_name": {"type": "string", "minLength": 1},
        "default_model": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "suggestions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "eval": {
      "description": "Eval set (JSONL) run by `archi eval` and by CI.",
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|^~|(^|/)\\.\\.(/|$)|\\\\)"}
    },
    "okg": {
      "description": "Supported AKMON (okg) version range, PEP 440 specifiers, e.g. \">=0.2.0,<0.3\".",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"}
  }
}
